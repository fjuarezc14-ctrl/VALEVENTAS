# Variables de entorno para VALEVENTAS by VT VALETEC

# Puerto del Backend Node.js / Express
BACKEND_PORT=8090

# Puerto del Frontend Nginx Web Server
FRONTEND_PORT=3000

# Entorno de ejecucion (production / development)
NODE_ENV=production

# Base de Datos PostgreSQL
POSTGRES_HOST=valeventas-db
POSTGRES_PORT=5432
POSTGRES_USER=valetec
POSTGRES_PASSWORD=valetec_secure_pass
POSTGRES_DB=valeventas_db

# Clave Secreta JWT para Autenticacion
JWT_SECRET=valetec_jwt_super_secret_key_2026
